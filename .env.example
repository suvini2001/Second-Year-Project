# Copy to .env (same folder as docker-compose.yml). Never commit .env.
N8N_DB_PASSWORD=replace-with-a-strong-password
# generate once with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=replace-with-64-hex-characters

# backend -> n8n: signs event webhooks
# generate once with: openssl rand -hex 32
DOCOP_WEBHOOK_SECRET=replace-with-64-hex-characters

# n8n -> backend: key for /api/internal/*
# generate once with: openssl rand -hex 32
DOCOP_INTERNAL_KEY=replace-with-64-hex-characters

# n8n webhook the backend forwards chat messages to
N8N_ASSISTANT_URL=http://n8n:5678/webhook/docop-assistant

DOCOP_MCP_KEY=<generated-random-value>
MCP_ADMIN_TOKEN=<different-generated-value>
MCP_ASSISTANT_TOKEN=<different-generated-value>
N8N_MCP_TOKEN=<different-generated-value>