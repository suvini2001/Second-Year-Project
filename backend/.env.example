# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=8000
NODE_ENV=development

# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me

# --- CORS: comma-separated list of allowed browser origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (image and file uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Brevo) ---
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=docopservice@docop.me
EMAIL_FROM_NAME=DocOp

# --- Chat limits (optional; these are the defaults) ---
MAX_MESSAGE_LENGTH=2000
BASIC_MODERATION_ENABLED=true
SEND_RATE_WINDOW_MS=10000
SEND_RATE_MAX=20

# Docker Compose overrides this with mongodb://mongo:27017/docop
MONGODB_URI=mongodb+srv://<user>:
<password>@<cluster>.mongodb.net/<dbname>