    {
      "parameters": {
        "jsCode": "// Preview: the count and times only. The doctor's email is NOT returned to Claude.\nconst s = $('Get day summary').first().json.body;\nreturn [{ json: {\n  ok: true, sent: false,\n  doctor: s.doctorName, date: s.date, count: s.count,\n  appointments: s.appointments.map(a => ({ time: a.time, patient: a.patient, status: a.status, paid: a.paid })),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "d51349b5-d19d-4c02-8860-f432224e4209",
      "name": "Preview"
    },
    {
      "parameters": {
        "jsCode": "// The email is built from database data only; the AI writes none of it.\nconst s = $('Get day summary').first().json.body;\n// escape text from the database before putting it in HTML\nconst esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\n\nconst rows = s.appointments\n  .map(a => `<tr><td>${esc(a.time)}</td><td>${esc(a.patient)}</td><td>${a.paid ? 'Paid' : 'Not paid'}</td></tr>`)\n  .join('');\n\nconst html = s.count === 0\n  ? `<p>Hello ${esc(s.doctorName)},</p><p>You have no DocOp appointments on ${esc(s.date)}.</p><p>DocOp</p>`\n  : `<p>Hello ${esc(s.doctorName)},</p>\n     <p>You have <b>${s.count}</b> appointment(s) on ${esc(s.date)} (Sri Lanka time):</p>\n     <table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">\n       <tr><th>Time</th><th>Patient</th><th>Payment</th></tr>${rows}\n     </table>\n     <p>DocOp</p>`;\n\nreturn [{ json: { to: s.doctorEmail, subject: `Your DocOp appointments on ${s.date}`, html } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
