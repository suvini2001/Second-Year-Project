        "jsCode": "// Tell Claude it worked, with a masked address only (a***@gmail.com).\nconst s = $('Get day summary').first().json.body;\nreturn [{ json: {\n  ok: true, sent: true,\n  doctor: s.doctorName, date: s.date, count: s.count,\n  sentTo: String(s.doctorEmail || '').replace(/^(.).*(@.*)$/, '$1***$2'),\n} }];"
      },
