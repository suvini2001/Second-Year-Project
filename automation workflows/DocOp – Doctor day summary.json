    {
      "parameters": {
        "jsCode": "// The doctor wasn't found (404), the name matched several doctors (409), or the date was bad (400).\n// Return a readable answer so Claude can ask the admin instead of crashing.\nconst r = $input.first().json;\nreturn [{ json: {\n  ok: false,\n  message: r.body?.error || `DocOp API error ${r.statusCode}`,\n  matches: r.body?.matches || [],\n} }];"
      },
